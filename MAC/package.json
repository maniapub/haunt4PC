{
  "name": "haunt",
  "version": "1.0.0",
  "description": "Haunt.gg desktop app for macOS",
  "main": "main.js",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE='' electron .",
    "build": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.haunt.app",
    "productName": "Haunt",
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Haunt"
    }
  }
}
